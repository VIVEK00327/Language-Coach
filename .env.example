# Copy to .env and fill in LOCALLY. Never commit .env. Never share real values.
SECRET_KEY=
FLASK_DEBUG=1
DATABASE_PATH=instance/coach.db
UPLOAD_MAX_MB=10

# ML settings
USE_MOCK_ML=1                 # 1 = mock recognizer (no models needed), 0 = real models
WHISPER_MODEL_SIZE=base       # tiny | base | small (CPU friendly)
PHONEME_MODEL_NAME=           # Hugging Face model id chosen by R2
HF_TOKEN=                     # only if a model needs it

# Optional LLM feedback (later); leave empty until used
LLM_API_KEY=
